{
  "Name": "MCH_PACS",
  "DicomAet": "MCH_PACS",
  "DicomPort": 4242,
  "HttpPort": 8042,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {
    "admin": "change-me-orthanc-admin-password"
  },
  "StorageDirectory": "/var/lib/orthanc/db",
